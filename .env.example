# ===== Flask / Security =====
# کلید امضای سشن و توکن‌ها — با: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=
FLASK_APP=app.py
# production (پیش‌فرض) یا development
APP_ENV=production

# ===== Database =====
# پیش‌فرض SQLite؛ برای production استفاده از PostgreSQL توصیه می‌شود
# نمونه‌ی Postgres: postgresql+psycopg2://user:pass@localhost:5432/vesthub
DATABASE_URL=sqlite:///instance/vesthub.db

# ===== Email (SMTP) =====
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER_NAME=VestHub Security
MAIL_DEFAULT_SENDER_EMAIL=noreply@vesthub.org

# ===== Initial Admin (used by seed.py) =====
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ===== Google OAuth =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
